# =============================================================================
# Agent Memory - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your deployment.
# Only configure the sections for frameworks you plan to use.
#
# All three memory frameworks (Mem0, Cognee, Graphiti) use Amazon Bedrock for
# LLM inference. No OpenAI or third-party API keys are required. Authentication
# uses the standard AWS credential chain (env vars, profiles, or IAM roles).

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================
# Which agent persona to load. See examples/ directory for available options.
# Options: default, travel_assistant (or any custom module in examples/)
AGENT_CONFIG = default

# Which memory framework backend to use.
# Options: mem0, cognee, graphiti
MEMORY_FRAMEWORK = mem0

# =============================================================================
# AWS CONFIGURATION (required for all frameworks)
# =============================================================================
# Region where Bedrock models are available and your infrastructure is deployed.
AWS_REGION = us-east-1

# AWS credentials (optional if using IAM roles, instance profiles, or ~/.aws/credentials)
# AWS_ACCESS_KEY_ID =
# AWS_SECRET_ACCESS_KEY =
# AWS_SESSION_TOKEN =
# AWS_PROFILE_NAME =

# =============================================================================
# BEDROCK MODEL CONFIGURATION
# =============================================================================
# LLM model used by Mem0, Cognee, Graphiti, and the Strands memory agent.
# Uses cross-region inference profile IDs (us. prefix) by default.
# See: https://docs.aws.amazon.com/bedrock/latest/userguide/models-supported.html
BEDROCK_MODEL_ID = us.anthropic.claude-sonnet-4-6

# Embedding model used by Mem0 and Graphiti for vector embeddings.
# Cognee uses Neptune Analytics' built-in vector support instead.
BEDROCK_EMBEDDING_MODEL_ID = amazon.titan-embed-text-v2:0

# =============================================================================
# MEM0 CONFIGURATION
# =============================================================================
# Mem0 2.x uses Neptune Analytics as a unified vector + graph store.
# No separate OpenSearch needed — Neptune Analytics handles both vector
# embeddings and graph relationships in a single resource.
#
# Endpoint format: neptune-graph://<graph-identifier>
# (Same format as Cognee — Mem0 and Cognee can share a Neptune Analytics graph)
MEM0_NEPTUNE_ENDPOINT =

# =============================================================================
# COGNEE CONFIGURATION
# =============================================================================
# Cognee uses Neptune Analytics for BOTH graph and vector storage (single endpoint).
# LLM provider is set to "bedrock" natively (Cognee 1.4+, no API key needed).
#
# Neptune Analytics endpoint format: neptune-graph://<graph-identifier>
COGNEE_ENDPOINT =

# Cognee internal storage paths (SQLite metadata, LanceDB local vectors, Kuzu local graph).
# These are for Cognee's bookkeeping only — your actual knowledge graph lives in Neptune.
# Defaults to .data_storage/ and .cognee_system/ in the project directory.
# For production/containers, use S3: s3://my-bucket/cognee/data
DATA_ROOT_DIRECTORY =
SYSTEM_ROOT_DIRECTORY =

# Disable Cognee's multi-user backend access control (required for Neptune Analytics,
# which doesn't support per-user database isolation). User isolation is handled at the
# application level via dataset names instead.
ENABLE_BACKEND_ACCESS_CONTROL = false

# Skip Cognee's LLM connection test on startup (can timeout with Bedrock due to cold starts).
COGNEE_SKIP_CONNECTION_TEST = true

# =============================================================================
# GRAPHITI CONFIGURATION
# =============================================================================
# Graphiti uses Amazon Neptune Database for graph storage and Amazon OpenSearch
# Serverless (AOSS) for vector search. LLM uses Bedrock via the OpenAI-compatible
# bedrock-mantle endpoint. Embeddings use Bedrock Titan directly via boto3.
# No API keys needed — a bearer token is generated from AWS credentials at runtime.
#
# Endpoints accept any of these formats (protocol prefixes are stripped automatically):
#   my-cluster.abc123.us-east-1.neptune.amazonaws.com
#   neptune-db://my-cluster.abc123.us-east-1.neptune.amazonaws.com
#   https://my-cluster.abc123.us-east-1.neptune.amazonaws.com
GRAPHITI_NEPTUNE_ENDPOINT =
GRAPHITI_AOSS_ENDPOINT =
# GRAPHITI_NEPTUNE_PORT = 8182

# =============================================================================
# NEPTUNE FLIGHTS ENDPOINT (optional - for the flights tool demo)
# =============================================================================
# If set, enables the flights booking tool which queries a separate Neptune
# graph database containing flight route data via the Neptune MCP server.
# Format: neptune-db://<cluster-endpoint> or neptune-graph://<graph-id>
# NEPTUNE_FLIGHTS_ENDPOINT =
